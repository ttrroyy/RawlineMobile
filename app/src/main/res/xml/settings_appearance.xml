<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">
 <PreferenceCategory app:title="@string/settings_appearance">
  <moe.matsuri.nb4a.ui.SimpleMenuPreference app:defaultValue="new" app:key="qmobileUiStyle" app:icon="@drawable/ic_mobile_style" app:title="@string/qmobile_ui_style" app:entries="@array/qmobile_ui_styles" app:entryValues="@array/qmobile_ui_style_values" app:useSimpleSummaryProvider="true" />
  <moe.matsuri.nb4a.ui.ColorPickerPreference app:defaultValue="19" app:title="@string/qmobile_color" app:key="appTheme" app:icon="@drawable/ic_mobile_palette" />
  <moe.matsuri.nb4a.ui.SimpleMenuPreference app:key="qmobileSurfaceTheme" app:icon="@drawable/ic_mobile_theme" app:title="@string/theme" app:persistent="false" app:entries="@array/qmobile_surface_themes" app:entryValues="@array/qmobile_surface_values" app:useSimpleSummaryProvider="true" />
  <Preference app:key="qmobileEditLayout" app:icon="@drawable/ic_mobile_dock_bottom" app:title="@string/qmobile_edit_layout" app:persistent="false" />
  <moe.matsuri.nb4a.ui.SimpleMenuPreference app:defaultValue="groups" app:key="qmobileListMode" app:icon="@drawable/ic_mobile_subscriptions" app:title="@string/qmobile_list_mode" app:entries="@array/qmobile_list_modes" app:entryValues="@array/qmobile_list_mode_values" app:useSimpleSummaryProvider="true" />
  <SwitchPreference app:defaultValue="false" app:key="alwaysShowAddress" app:icon="@drawable/ic_mobile_globe" app:title="@string/always_show_address" app:summary="@string/always_show_address_sum" />
  <SwitchPreference app:defaultValue="false" app:key="compactProfileRows" app:icon="@drawable/ic_mobile_subscriptions" app:title="@string/compact_profile_rows" app:summary="@string/compact_profile_rows_sum" />
  <SwitchPreference app:defaultValue="false" app:key="compactGroupCards" app:icon="@drawable/ic_mobile_subscriptions" app:title="@string/compact_group_cards" app:summary="@string/compact_group_cards_sum" />
  <moe.matsuri.nb4a.ui.SimpleMenuPreference app:defaultValue="" app:entries="@array/language_entries" app:entryValues="@array/language_values" app:key="appLanguage" app:icon="@drawable/ic_mobile_language" app:title="@string/language" app:useSimpleSummaryProvider="true" />
 </PreferenceCategory>
 <PreferenceCategory app:title="@string/cag_notification">
  <SwitchPreference app:defaultValue="false" app:key="qmobileNotificationSpeed" app:icon="@drawable/ic_baseline_speed_24" app:title="@string/qmobile_notification_speed" />
 </PreferenceCategory>
</PreferenceScreen>
